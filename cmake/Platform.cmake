function(justconnect_platform TARGET)
    if(WIN32)
        set(PLATFORM windows)
    elseif(APPLE)
        set(PLATFORM macos)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(PLATFORM linux)
    else()
        set(PLATFORM unsupported)
    endif()
    add_library(${TARGET} STATIC "${REPO}/infrastructure/platform/${PLATFORM}/systemproxybackend.cpp"
        "${REPO}/infrastructure/platform/${PLATFORM}/credentialstore.cpp"
        "${REPO}/infrastructure/platform/platformcommand.cpp"
        "${REPO}/infrastructure/platform/dnssnapshot.cpp"
        "${REPO}/infrastructure/platform/${PLATFORM}/autostart.cpp")
    target_include_directories(${TARGET} PUBLIC "${REPO}")
    target_link_libraries(${TARGET} PUBLIC Qt6::Core)
    if(WIN32)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/windows/dnssnapshot.cpp")
        target_link_libraries(${TARGET} PRIVATE wininet rasapi32 advapi32)
    elseif(APPLE)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/macos/dnssnapshot.cpp")
        target_link_libraries(${TARGET} PRIVATE "-framework Security" "-framework CoreFoundation" "-framework SystemConfiguration")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        find_package(Qt6 REQUIRED COMPONENTS DBus)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/linux/dnssnapshot.cpp"
            "${REPO}/infrastructure/platform/linux/tundevice.cpp")
        target_link_libraries(${TARGET} PUBLIC Qt6::DBus)
    endif()
endfunction()

function(justconnect_credential_tests TARGET LIBRARY)
    add_executable(${TARGET} "${REPO}/tests/platform/credentialstore_test.cpp")
    target_link_libraries(${TARGET} PRIVATE ${LIBRARY} Qt6::Core)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        add_test(NAME ${TARGET} COMMAND "${Python3_EXECUTABLE}"
            "${REPO}/tests/platform/credentialstore_linux.py" "$<TARGET_FILE:${TARGET}>")
    else()
        add_test(NAME ${TARGET} COMMAND ${TARGET})
    endif()
    set_tests_properties(${TARGET} PROPERTIES TIMEOUT 75)
endfunction()

function(justconnect_platform_tests TARGET LIBRARY)
    add_executable(platformcommand_test "${REPO}/tests/platform/platformcommand_test.cpp")
    target_link_libraries(platformcommand_test PRIVATE ${LIBRARY} Qt6::Core)
    add_test(NAME platformcommand_test COMMAND platformcommand_test)
    set_tests_properties(platformcommand_test PROPERTIES TIMEOUT 10)
    if(APPLE)
        add_executable(macos_dnssnapshot_test "${REPO}/tests/platform/dnssnapshot_macos_test.cpp")
        target_link_libraries(macos_dnssnapshot_test PRIVATE ${LIBRARY} Qt6::Core)
        add_test(NAME macos_dnssnapshot_test COMMAND macos_dnssnapshot_test)
        add_test(NAME macos_dnssnapshot_test_native COMMAND macos_dnssnapshot_test --native)
        set_tests_properties(macos_dnssnapshot_test macos_dnssnapshot_test_native PROPERTIES TIMEOUT 20)
    endif()
    add_executable(windows_dnssnapshot_test "${REPO}/tests/platform/dnssnapshot_windows_test.cpp")
    if(NOT WIN32)
        target_sources(windows_dnssnapshot_test PRIVATE "${REPO}/infrastructure/platform/windows/dnssnapshot.cpp")
    endif()
    target_link_libraries(windows_dnssnapshot_test PRIVATE ${LIBRARY} Qt6::Core)
    add_test(NAME windows_dnssnapshot_test COMMAND windows_dnssnapshot_test)
    set_tests_properties(windows_dnssnapshot_test PROPERTIES TIMEOUT 20)
    if(WIN32)
        add_test(NAME windows_dnssnapshot_test_native COMMAND windows_dnssnapshot_test --native)
        add_test(NAME windows_dnssnapshot_test_module_scope COMMAND windows_dnssnapshot_test --module-scope)
        add_test(NAME windows_dnssnapshot_test_missing_doh COMMAND windows_dnssnapshot_test --missing-doh)
        add_test(NAME windows_dnssnapshot_test_missing_nrpt COMMAND windows_dnssnapshot_test --missing-nrpt)
        add_test(NAME windows_dnssnapshot_test_empty_nrpt COMMAND windows_dnssnapshot_test --empty-nrpt)
        set_tests_properties(windows_dnssnapshot_test_native windows_dnssnapshot_test_module_scope
            windows_dnssnapshot_test_missing_doh windows_dnssnapshot_test_missing_nrpt
            windows_dnssnapshot_test_empty_nrpt PROPERTIES TIMEOUT 20)
    endif()
    add_executable(${TARGET} "${REPO}/tests/platform/platformbackend_test.cpp")
    target_link_libraries(${TARGET} PRIVATE ${LIBRARY} Qt6::Core)
    if(APPLE)
        add_test(NAME ${TARGET} COMMAND sudo -n "$<TARGET_FILE:${TARGET}>")
    else()
        add_test(NAME ${TARGET} COMMAND ${TARGET})
    endif()
    set_tests_properties(${TARGET} PROPERTIES TIMEOUT 45)
    add_test(NAME ${TARGET}_readonly COMMAND ${TARGET} --readonly)
    set_tests_properties(${TARGET}_readonly PROPERTIES TIMEOUT 45)
    if(WIN32 AND "$ENV{GITHUB_ACTIONS}" STREQUAL "true")
        add_test(NAME ${TARGET}_native_roundtrip COMMAND ${TARGET} --native-roundtrip)
        set_tests_properties(${TARGET}_native_roundtrip PROPERTIES TIMEOUT 45)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        add_executable(linux_tundevice_test "${REPO}/tests/platform/tundevice_linux_test.cpp")
        target_link_libraries(linux_tundevice_test PRIVATE ${LIBRARY} Qt6::Core)
        target_link_options(linux_tundevice_test PRIVATE "LINKER:--wrap=ioctl")
        add_test(NAME linux_tundevice_test COMMAND linux_tundevice_test)
        set_tests_properties(linux_tundevice_test PROPERTIES TIMEOUT 10)
        add_executable(dnssnapshot_test "${REPO}/tests/platform/dnssnapshot_linux_test.cpp")
        target_link_libraries(dnssnapshot_test PRIVATE ${LIBRARY} Qt6::Core Qt6::DBus)
        add_test(NAME dnssnapshot_test COMMAND dbus-run-session -- "$<TARGET_FILE:dnssnapshot_test>")
        add_test(NAME dnssnapshot_test_native COMMAND dnssnapshot_test --native)
        set_tests_properties(dnssnapshot_test dnssnapshot_test_native PROPERTIES TIMEOUT 20)
        add_test(NAME ${TARGET}_isolated COMMAND ${TARGET} --isolated)
        set_tests_properties(${TARGET}_isolated PROPERTIES TIMEOUT 45)
        add_test(NAME ${TARGET}_isolated_kde COMMAND dbus-run-session -- "$<TARGET_FILE:${TARGET}>" --isolated-kde)
        set_tests_properties(${TARGET}_isolated_kde PROPERTIES TIMEOUT 45)
    endif()
endfunction()

function(justconnect_autostart_tests TARGET LIBRARY)
    add_executable(${TARGET} "${REPO}/tests/platform/autostart_test.cpp")
    target_link_libraries(${TARGET} PRIVATE ${LIBRARY} Qt6::Core)
    if(APPLE)
        set_target_properties(${TARGET} PROPERTIES MACOSX_BUNDLE ON)
    endif()
    add_test(NAME ${TARGET} COMMAND ${TARGET})
    set_tests_properties(${TARGET} PROPERTIES TIMEOUT 45)
endfunction()
