if(APPLE)
    enable_language(OBJCXX)
endif()

function(justconnect_platform TARGET)
    find_package(Qt6 REQUIRED COMPONENTS Network)
    if(WIN32)
        set(PLATFORM windows)
    elseif(APPLE)
        set(PLATFORM macos)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(PLATFORM linux)
    else()
        set(PLATFORM unsupported)
    endif()
    add_library(${TARGET} STATIC "${REPO}/infrastructure/platform/${PLATFORM}/systemproxybackend.cpp"
        "${REPO}/infrastructure/platform/${PLATFORM}/credentialstore.cpp"
        "${REPO}/infrastructure/platform/proxyrecovery.cpp"
        "${REPO}/infrastructure/platform/proxyjournal.cpp"
        "${REPO}/infrastructure/platform/dnssnapshot.cpp"
        "${REPO}/infrastructure/platform/${PLATFORM}/autostart.cpp")
    target_include_directories(${TARGET} PUBLIC "${REPO}")
    target_link_libraries(${TARGET} PUBLIC Qt6::Core Qt6::Network)
    add_executable(JustConnectProxyRecovery "${REPO}/infrastructure/platform/proxyrecoverymain.cpp")
    target_link_libraries(JustConnectProxyRecovery PRIVATE ${TARGET})
    if(APPLE)
        set_target_properties(JustConnectProxyRecovery PROPERTIES INSTALL_RPATH "@executable_path/../Frameworks")
        set(PROXY_RECOVERY_DESTINATION "JustConnect.app/Contents/MacOS")
    elseif(WIN32)
        set(PROXY_RECOVERY_DESTINATION ".")
    else()
        set(PROXY_RECOVERY_DESTINATION "usr/bin")
    endif()
    install(TARGETS JustConnectProxyRecovery RUNTIME DESTINATION "${PROXY_RECOVERY_DESTINATION}" COMPONENT CoreRuntime)
    if(NOT APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/platformcommand.cpp")
    endif()
    if(WIN32 OR APPLE OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/persistentproxy.cpp")
    endif()
    if(WIN32)
        add_executable(JustConnectDnsReader "${REPO}/infrastructure/platform/windows/dnsreader.cpp")
        set_target_properties(JustConnectDnsReader PROPERTIES AUTOMOC OFF AUTOUIC OFF AUTORCC OFF)
        target_link_libraries(JustConnectDnsReader PRIVATE ws2_32)
        install(TARGETS JustConnectDnsReader RUNTIME DESTINATION . COMPONENT CoreRuntime)
        add_dependencies(${TARGET} JustConnectDnsReader)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/windows/dnssnapshot.cpp"
            "${REPO}/infrastructure/platform/windows/proxyrecoverylock.cpp")
        target_link_libraries(${TARGET} PRIVATE wininet rasapi32 advapi32)
    elseif(APPLE)
        include("${REPO}/cmake/MacNetworkHelper.cmake")
        justconnect_mac_network_helper()
        add_dependencies(${TARGET} JustConnectNetworkHelper)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/macos/dnssnapshot.cpp"
            "${REPO}/infrastructure/platform/macos/networkhelperclient.cpp"
            "${REPO}/infrastructure/platform/macos/networkhelperclient.h"
            "${REPO}/infrastructure/platform/macos/helperregistration.mm")
        set_target_properties(${TARGET} PROPERTIES AUTOMOC ON OBJCXX_STANDARD 17 OBJCXX_STANDARD_REQUIRED ON)
        target_compile_options(${TARGET} PRIVATE -fblocks)
        target_link_libraries(${TARGET} PUBLIC justconnect_macos_network_helper
            PRIVATE "-framework Foundation" "-framework ServiceManagement" "-framework SystemConfiguration")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        find_package(Qt6 REQUIRED COMPONENTS DBus)
        include("${REPO}/cmake/NetworkHelper.cmake")
        justconnect_linux_network_helper()
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/linux/networkhelperclient.cpp"
            "${REPO}/infrastructure/platform/linux/networkhelperclient.h"
            "${REPO}/infrastructure/platform/linux/dnsroutepublisher.cpp")
        set_target_properties(${TARGET} PROPERTIES AUTOMOC ON)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/platform/linux/dnssnapshot.cpp")
        target_link_libraries(${TARGET} PUBLIC Qt6::DBus justconnect_network_helper)
    endif()
endfunction()

function(justconnect_credential_tests TARGET LIBRARY)
    add_executable(${TARGET} "${REPO}/tests/platform/credentialstore_test.cpp")
    target_link_libraries(${TARGET} PRIVATE ${LIBRARY} Qt6::Core)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        add_test(NAME ${TARGET} COMMAND "${Python3_EXECUTABLE}"
            "${REPO}/tests/platform/credentialstore_linux.py" "$<TARGET_FILE:${TARGET}>")
    else()
        add_test(NAME ${TARGET} COMMAND ${TARGET})
    endif()
    set_tests_properties(${TARGET} PROPERTIES TIMEOUT 75)
    if(APPLE)
        set_tests_properties(${TARGET} PROPERTIES RESOURCE_LOCK system_proxy_recovery_user)
    endif()
endfunction()

