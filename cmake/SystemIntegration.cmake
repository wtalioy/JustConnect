function(justconnect_windows_dns_reader TARGET)
    add_executable(${TARGET} "${REPO}/infrastructure/dns/windows/dnsreader.cpp")
    set_target_properties(${TARGET} PROPERTIES AUTOMOC OFF AUTOUIC OFF AUTORCC OFF)
    target_compile_features(${TARGET} PRIVATE cxx_std_17)
    if(WIN32)
        target_link_libraries(${TARGET} PRIVATE ws2_32 advapi32 iphlpapi ole32)
    endif()
endfunction()

function(justconnect_system_integration TARGET)
    find_package(Qt6 REQUIRED COMPONENTS Network)
    if(WIN32)
        set(PLATFORM windows)
    else()
        set(PLATFORM macos)
    endif()
    add_library(${TARGET} STATIC "${REPO}/infrastructure/credentialstore/${PLATFORM}/credentialstore.cpp"
        "${REPO}/infrastructure/systemproxy/proxyrecovery.cpp"
        "${REPO}/infrastructure/systemproxy/proxyjournal.cpp"
        "${REPO}/infrastructure/systemproxy/persistentproxy.cpp"
        "${REPO}/infrastructure/dns/dnssnapshot.cpp"
        "${REPO}/infrastructure/routing/originalexit.cpp"
        "${REPO}/infrastructure/process/${PLATFORM}/running.cpp"
        "${REPO}/infrastructure/autostart/${PLATFORM}/autostart.cpp")
    target_include_directories(${TARGET} PUBLIC "${REPO}")
    target_link_libraries(${TARGET} PUBLIC Qt6::Core Qt6::Network)
    set_target_properties(${TARGET} PROPERTIES AUTOMOC ON)
    target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/systemproxy/proxychanges.h")
    if(WIN32)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/systemproxy/windows/systemproxybackend.cpp"
            "${REPO}/infrastructure/systemproxy/windows/proxychanges.cpp")
    else()
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/systemproxy/macos/proxychanges.cpp")
    endif()
    add_executable(JustConnectProxyRecovery "${REPO}/infrastructure/systemproxy/proxyrecoverymain.cpp")
    target_link_libraries(JustConnectProxyRecovery PRIVATE ${TARGET})
    if(APPLE)
        target_sources(JustConnectProxyRecovery PRIVATE "${REPO}/infrastructure/systemproxy/macos/proxyreceiptstore.cpp")
        set_target_properties(JustConnectProxyRecovery PROPERTIES INSTALL_RPATH "@executable_path/../Frameworks")
        set(PROXY_RECOVERY_DESTINATION "JustConnect.app/Contents/MacOS")
    else()
        set(PROXY_RECOVERY_DESTINATION ".")
    endif()
    install(TARGETS JustConnectProxyRecovery RUNTIME DESTINATION "${PROXY_RECOVERY_DESTINATION}" COMPONENT CoreRuntime)
    if(WIN32)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/process/command.cpp")
        include("${REPO}/cmake/WindowsNetworkHelper.cmake")
        justconnect_windows_network_client(justconnect_windows_network_client)
        target_link_libraries(${TARGET} PUBLIC justconnect_windows_network_client)
        justconnect_windows_dns_reader(JustConnectDnsReader)
        install(TARGETS JustConnectDnsReader RUNTIME DESTINATION . COMPONENT CoreRuntime)
        add_dependencies(${TARGET} JustConnectDnsReader)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/dns/windows/dnssnapshot.cpp"
            "${REPO}/infrastructure/systemproxy/windows/proxyrecoverylock.cpp")
        target_link_libraries(${TARGET} PRIVATE wininet rasapi32 advapi32 iphlpapi)
    else()
        include("${REPO}/cmake/MacNetworkHelper.cmake")
        justconnect_mac_network_helper()
        add_dependencies(${TARGET} JustConnectNetworkHelper)
        target_sources(${TARGET} PRIVATE "${REPO}/infrastructure/dns/macos/dnssnapshot.cpp"
            "${REPO}/infrastructure/networkhelper/macos/networkownership.cpp"
            "${REPO}/infrastructure/networkhelper/macos/networkhelperclient.cpp"
            "${REPO}/infrastructure/networkhelper/macos/networkhelperclient.h"
            "${REPO}/infrastructure/networkhelper/macos/helperregistration.mm")
        set_target_properties(${TARGET} PROPERTIES AUTOMOC ON OBJCXX_STANDARD 17 OBJCXX_STANDARD_REQUIRED ON)
        target_compile_options(${TARGET} PRIVATE -fblocks)
        target_link_libraries(${TARGET} PUBLIC justconnect_macos_network_helper
            PRIVATE "-framework Foundation" "-framework ServiceManagement" "-framework SystemConfiguration")
    endif()
endfunction()

