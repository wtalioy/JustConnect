function(justconnect_windows_device TARGET)
    if(NOT WIN32 OR NOT EXISTS "${WINTUN_INCLUDE_DIR}/wintun.h")
        message(FATAL_ERROR "Windows device requires the verified Wintun SDK header")
    endif()
    add_library(${TARGET} STATIC "${REPO}/infrastructure/tundevice/windows/adapter.cpp")
    target_include_directories(${TARGET} PUBLIC "${REPO}" "${WINTUN_INCLUDE_DIR}")
    target_compile_features(${TARGET} PUBLIC cxx_std_17)
    target_compile_definitions(${TARGET} PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN _WIN32_WINNT=0x0A00)
    target_link_libraries(${TARGET} PUBLIC iphlpapi ws2_32 ole32)
endfunction()
