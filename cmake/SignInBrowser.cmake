include_guard(GLOBAL)
if(WIN32)
    set(JC_BROWSER_QPA windows)
else()
    enable_language(OBJCXX)
    set(JC_BROWSER_QPA cocoa)
endif()

function(justconnect_signin_browser TARGET)
    add_library(${TARGET} STATIC "${REPO}/presentation/browser/signinbrowser.h")
    set_target_properties(${TARGET} PROPERTIES AUTOMOC ON OBJCXX_STANDARD 17 OBJCXX_STANDARD_REQUIRED ON)
    target_include_directories(${TARGET} PUBLIC "${REPO}")
    target_link_libraries(${TARGET} PUBLIC Qt6::Widgets Qt6::Network)
    if(WIN32)
        include(FetchContent)
        FetchContent_Declare(webview2
            URL https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/1.0.4314.35/microsoft.web.webview2.1.0.4314.35.nupkg
            URL_HASH SHA256=90778deb1b77e36292828b4b5833c9255c27533f40e0ddd55891ae718944edc4
            DOWNLOAD_NAME WebView2.zip)
        FetchContent_MakeAvailable(webview2)
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$" OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
            set(arch arm64)
        else()
            set(arch x64)
        endif()
        target_sources(${TARGET} PRIVATE "${REPO}/presentation/browser/windows/browser.cpp")
        target_include_directories(${TARGET} PRIVATE "${webview2_SOURCE_DIR}/build/native/include")
        target_link_libraries(${TARGET} PRIVATE "${webview2_SOURCE_DIR}/build/native/${arch}/WebView2LoaderStatic.lib" ole32 oleaut32 crypt32 user32 version)
        install(FILES "${webview2_SOURCE_DIR}/LICENSE.txt" DESTINATION licenses RENAME LICENSE.WebView2 COMPONENT CoreRuntime)
    else()
        target_sources(${TARGET} PRIVATE "${REPO}/presentation/browser/macos/browser.mm")
        set_source_files_properties("${REPO}/presentation/browser/macos/browser.mm" PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
        target_link_libraries(${TARGET} PRIVATE "-framework WebKit" "-framework AppKit" "-framework Security")
    endif()
endfunction()
