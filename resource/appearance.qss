QWidget { font-size: 14px; font-weight: 400; }
QMainWindow, QDialog { background: #fafbfc; color: #182132; }
QMainWindow[nativeBackdrop="true"], QDialog[nativeBackdrop="true"] { background: rgba(250,251,252,52); }
QWidget#centralWidget { background: transparent; }
QLabel { color: #182132; background: transparent; }
QPushButton, QToolButton, QComboBox {
    min-height: 38px; border: 1px solid #d8dce5; border-radius: 8px;
    padding: 0 14px; background: rgba(255,255,255,220); color: #182132;
}
QPushButton:hover, QToolButton:hover, QComboBox:hover { background: #f0f2ff; border-color: #a9b1e7; }
QPushButton:pressed, QToolButton:pressed { background: #e5e9ff; }
QPushButton:focus, QToolButton:focus, QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QPlainTextEdit:focus, QTreeWidget:focus, QListWidget:focus { border: 1px solid #5367e8; }
QPushButton[iconOnly="true"], QToolButton#detailsToolsButton { min-width: 38px; max-width: 38px; padding: 0; }
QPushButton:disabled, QToolButton:disabled, QComboBox:disabled { color: #8a92a1; background: #f0f1f5; border-color: #e4e7ed; }
QPushButton:default:enabled, QPushButton#connectButton:enabled { color: white; background: #5367e8; border-color: #5367e8; font-weight: 600; }
QPushButton:default:enabled:hover, QPushButton#connectButton:enabled:hover { background: #4458d5; }
QPushButton:default:focus, QPushButton#connectButton:focus { border-color: #182132; }
QPushButton#connectButton { min-height: 44px; }
QPushButton#connectButton[connectionState="connected"], QPushButton#connectButton[connectionState="starting"], QPushButton#connectButton[connectionState="stopping"], QPushButton#connectButton[connectionState="reconnecting"] { color: #5367e8; background: rgba(255,255,255,200); border-color: #a9b1e7; }
QPushButton:flat { border-color: transparent; background: transparent; color: #616b7c; }
QPushButton:flat:hover { background: rgba(229,233,255,170); }
QPushButton:flat:focus { border-color: #5367e8; }
QToolButton#preferencesButton { padding: 0; min-width: 38px; border-color: transparent; background: transparent; }
QToolButton#preferencesButton::menu-indicator { image: none; }
QToolButton#detailsToolsButton::menu-indicator { image: none; }
QToolButton#schoolCaToggle { border: none; background: transparent; padding: 0 8px 0 0; min-height: 28px; color: #616b7c; }
QToolButton#backButton, QToolButton#forwardButton, QToolButton#reloadButton { padding: 0; min-width: 38px; max-width: 38px; }
QToolButton#profileMenuButton { min-height: 30px; max-height: 30px; padding: 0 20px 0 4px; font-size: 14px; font-weight: 600; color: #263143; border-color: #e0e5ed; background: #eef1f6; }
QToolButton#profileMenuButton:hover { background: #e5eaf3; border-color: #cbd4e3; }
QToolButton#profileMenuButton:pressed { background: #dfe5fa; }
QToolButton#profileMenuButton:focus { border-color: #5367e8; }
QToolButton#profileMenuButton::menu-indicator, QComboBox::down-arrow { image: url(:/resource/chevron.svg); width: 16px; height: 16px; }
QToolButton#profileMenuButton::menu-indicator { subcontrol-origin: padding; subcontrol-position: right center; right: 12px; }
QComboBox { max-height: 38px; border-radius: 8px; padding-left: 12px; padding-right: 36px; }
QComboBox::drop-down { border: none; width: 32px; subcontrol-origin: padding; subcontrol-position: right center; }
QComboBox::down-arrow { subcontrol-position: center; }
QComboBox QAbstractItemView { background: white; color: #182132; selection-background-color: #e9ecff; selection-color: #3546ad; }
QLineEdit, QSpinBox, QPlainTextEdit, QListWidget, QTreeWidget {
    border: 1px solid #d8dce5; border-radius: 8px; background: rgba(255,255,255,225); color: #182132; padding: 7px;
    selection-background-color: #5367e8; selection-color: white;
}
QLineEdit, QSpinBox { min-height: 24px; max-height: 24px; }
QLineEdit { padding-left: 10px; padding-right: 10px; lineedit-clear-button-icon: url(:/resource/close.svg); }
QLineEdit QAbstractButton { min-height: 0; min-width: 0; padding: 0; border: none; background: transparent; border-radius: 8px; }
QLineEdit QAbstractButton:hover { background: rgba(225,230,240,180); }
QSpinBox { padding-left: 10px; padding-right: 36px; }
QSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 32px; height: 19px; border: none; background: transparent; }
QSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 32px; height: 19px; border: none; background: transparent; }
QSpinBox::up-arrow { image: url(:/resource/chevron-up.svg); width: 12px; height: 12px; }
QSpinBox::down-arrow { image: url(:/resource/chevron.svg); width: 12px; height: 12px; }
QCheckBox, QRadioButton { spacing: 8px; color: #263143; min-height: 30px; }
QGroupBox { font-weight: 600; background: transparent; border: none; border-top: 1px solid #dfe3eb; border-radius: 0; margin-top: 18px; padding: 20px 0 0 0; color: #182132; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 0; padding: 0 0 6px 0; }
QTabWidget::pane { border: none; }
QTabWidget::tab-bar { alignment: left; }
QTabBar::tab { padding: 8px 16px; min-height: 18px; min-width: 48px; margin-right: 4px; color: #737c8b; border: 1px solid transparent; border-radius: 8px; font-weight: 600; }
QTabBar::tab:hover { background: rgba(225,230,240,180); color: #263143; }
QTabBar::tab:selected { color: #4458d5; background: rgba(226,231,252,210); }
QTabBar::tab:selected:hover { background: #dfe5fa; }
QTabBar::tab:focus { border-color: #5367e8; }
QScrollArea { border: none; background: transparent; }
QMenu { border: 1px solid #d8dce5; border-radius: 8px; padding: 6px; background: #fafbfe; color: #182132; }
QMenu::item { padding: 8px 28px 8px 14px; border-radius: 8px; }
QMenu::item:selected { background: #e9ecff; }
QMenu::item:disabled { color: #8792a3; }
QMenu::separator { height: 1px; background: #d9e0ec; margin: 5px 10px; }
QLabel#statusTitleLabel { font-size: 24px; font-weight: 600; }
QLabel#statusHintLabel { color: #8c601b; font-size: 13px; }
QLabel#statusIndicator { background: transparent; border: none; }
QLabel#statusDetailLabel, QLabel#versionLabel { font-size: 12px; color: #737c8b; }
QLabel#profileDetailLabel { font-size: 14px; color: #616b7c; }
QPlainTextEdit#logPlainTextEdit { font-size: 12px; background: #f3f5f9; border: none; }
QFrame#logPanel { background: transparent; border: none; }
QFrame[divider="true"] { background: #dfe3eb; min-height: 1px; max-height: 1px; border: none; }
QPushButton#detailsButton { min-height: 32px; padding: 0 16px; font-size: 13px; }
QLabel[heading="true"] { font-size: 18px; font-weight: 600; }
QHeaderView::section { padding: 10px 8px; background: #f1f3f8; color: #616b7c; border: none; font-weight: 600; }
QTreeWidget { padding: 0; alternate-background-color: #f6f7fb; }
QTreeWidget::item { padding: 10px 8px; border-bottom: 1px solid #edf0f5; }
QTreeWidget::item:selected { background: #e9ecff; color: #182132; }
QTreeWidget#diagnosticReport::item { padding: 12px; }
QTreeWidget#diagnosticReport { border: none; background: rgba(255,255,255,235); }

QListWidget::item { min-height: 24px; padding: 10px 8px; }

QLabel[secondary="true"] { color: #737c8b; font-size: 12px; }
QLabel[warning="true"] { color: #835b1d; }
QWidget#applicationPreferencesContents, QWidget#loginTabContents, QWidget#overviewTab, QWidget#logsTab { background: rgba(250,251,252,235); border-radius: 8px; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: #b5c2d4; border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QPushButton[iconOnly="true"], QToolButton#detailsToolsButton, QToolButton#preferencesButton,
QToolButton#backButton, QToolButton#forwardButton, QToolButton#reloadButton {
    border: 1px solid transparent; background: transparent; border-radius: 8px;
}
QPushButton[iconOnly="true"]:hover, QToolButton#detailsToolsButton:hover, QToolButton#preferencesButton:hover,
QToolButton#backButton:hover, QToolButton#forwardButton:hover, QToolButton#reloadButton:hover {
    background: rgba(225,230,240,180);
}
QPushButton[iconOnly="true"]:pressed, QToolButton#detailsToolsButton:pressed, QToolButton#preferencesButton:pressed,
QToolButton#backButton:pressed, QToolButton#forwardButton:pressed, QToolButton#reloadButton:pressed {
    background: #dfe5fa;
}
QPushButton[iconOnly="true"]:focus, QToolButton#detailsToolsButton:focus, QToolButton#preferencesButton:focus,
QToolButton#backButton:focus, QToolButton#forwardButton:focus, QToolButton#reloadButton:focus {
    border-color: #5367e8;
}
QPushButton[iconOnly="true"]:disabled, QToolButton#backButton:disabled, QToolButton#forwardButton:disabled,
QToolButton#reloadButton:disabled { background: transparent; border-color: transparent; }
